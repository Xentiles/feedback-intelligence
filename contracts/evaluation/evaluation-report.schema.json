{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feedback-intelligence.local/contracts/evaluation-report-1.0.0.json",
  "title": "Evaluation score report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sample_version", "split", "locked_test_unlocked", "reference", "engine", "inputs", "summary", "questions", "slices", "operations", "report_sha256"],
  "properties": {
    "schema_version": { "const": "feedback-evaluation-report/1.0.0" },
    "sample_version": { "const": "feedback-decision-1.0.0" },
    "split": { "enum": ["development", "calibration", "locked_test", "all"] },
    "partial_evaluation": { "type": "boolean" },
    "locked_test_unlocked": { "type": "boolean" },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "model"],
      "properties": {
        "kind": { "enum": ["human_gold", "ai_reference"] },
        "model": { "type": ["string", "null"] }
      }
    },
    "engine": { "type": "object" },
    "inputs": { "type": "object" },
    "summary": {
      "type": "object",
      "required": ["record_count", "success_count", "error_count", "error_rate", "primary_topic_macro_f1", "primary_topic_accuracy"]
    },
    "questions": { "type": "object", "minProperties": 14, "maxProperties": 14 },
    "slices": { "type": "object" },
    "operations": { "type": "object" },
    "report_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
