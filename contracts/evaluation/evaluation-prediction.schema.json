{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feedback-intelligence.local/contracts/evaluation-prediction-1.0.0.json",
  "title": "Evaluation prediction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feedback_id", "split", "engine", "status", "answers", "error_type", "execution"],
  "properties": {
    "schema_version": { "const": "feedback-evaluation-prediction/1.0.0" },
    "feedback_id": { "type": "string", "format": "uuid" },
    "split": { "enum": ["development", "calibration", "locked_test"] },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "requested_model", "resolved_model", "run_id", "schema_sha256"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "requested_model": { "type": "string", "minLength": 1 },
        "resolved_model": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "schema_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "status": { "enum": ["success", "error"] },
    "answers": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "minProperties": 14,
          "maxProperties": 14,
          "additionalProperties": { "$ref": "#/$defs/answer" }
        }
      ]
    },
    "error_type": { "type": ["string", "null"] },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency_ms", "input_tokens", "output_tokens", "cost_usd"],
      "properties": {
        "latency_ms": { "type": "number", "minimum": 0 },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cost_usd": { "type": ["number", "null"], "minimum": 0 }
      }
    }
  },
  "$defs": {
    "answer": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["choice", "score", "noul"] },
        "choice": { "type": "string" },
        "score": { "type": "number" },
        "noul": { "type": "number", "minimum": 0, "maximum": 1 },
        "probabilities": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
