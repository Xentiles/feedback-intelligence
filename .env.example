# Optional host ports. The shell, API, and one-shot worker need no credentials.
WEB_PORT=8080
API_PORT=5080

# Optional `storage` Compose profile. Set passwords locally before starting it.
# The pipeline profile uses these values for transactional persistence and projection.
POSTGRES_DB=feedback_intelligence
POSTGRES_USER=feedback_intelligence
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
CLICKHOUSE_DB=feedback_intelligence
CLICKHOUSE_USER=feedback_intelligence
CLICKHOUSE_PASSWORD=
CLICKHOUSE_HTTP_PORT=8123

# Enable the write API only for a private/local runtime. The public demo stays read-only.
INGESTION_ENABLED=false
INGESTION_API_KEY=
INGESTION_DECISION_ENGINE=rules
INGESTION_DECISION_MODEL=rules-1.0.0
INGESTION_RATE_LIMIT=30
INGESTION_RATE_WINDOW_SECONDS=60
WORKER_NAME=decision-worker-local
WORKER_POLL_SECONDS=1
# `candidate_statistical` is evaluated and selectable but is not the promoted default.
TREND_ALGORITHM=simple_rate_change

# Host-side equivalents used by `feedback-storage demo`; the Compose pipeline
# injects service-network addresses automatically.
POSTGRES_DSN=postgresql://feedback_intelligence:change-me@127.0.0.1:5432/feedback_intelligence
CLICKHOUSE_URL=http://127.0.0.1:8123

# Decision engine configuration. Fixture mode requires a recorded fixture path at
# the command boundary; model modes are opt-in with `--engine semif` or `--engine llm`.
# Never expose provider keys through a VITE_* variable or browser bundle.
DECISION_ENGINE=fixture
SEMIF_MODEL=semif-qwen3.5-4b-mlx-q4-851bf6e8
# The LLM comparison uses the System One Adapter with native structured
# outputs. Keep the API key only in the ignored local .env file.
OPENAI_API_KEY=
LLM_MODEL=gpt-5.4-mini-2026-03-17

# Canonical dataset provider. The committed synthetic source needs no download.
FEEDBACK_DATA_PROVIDER=synthetic
# Optional override. Defaults are data/demo/feedback.jsonl for synthetic and
# data/external/olist/raw for Olist.
FEEDBACK_DATA_PATH=

# Optional `observability` profile. API and processing-worker exporters stay off by default.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
